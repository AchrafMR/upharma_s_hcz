{% extends 'base.html.twig' %}

{% block title %}Gestion des Ventes{% endblock %}

{% block stylesheets %}

  <style>
  .force-right-align {
    text-align: right !important;
    padding-right: 12px !important;
  }
  .urgent-check-wrapper {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .urgent-check-wrapper input {
    margin: 0 0 0 45px !important;
  }
  .urgent-check-wrapper label {
    margin: 0 !important;
    font-weight: normal !important;
  }
  .form-row {
    margin-bottom: -10px !important;
  }

  </style>
  

  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
{% endblock %}

{% block body %}
<div class="main">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mt-3">
        <div class="row no-gutters mb-2">
          <div class="col-md-6 d-flex justify-content-start align-items-center">
            <h4>LISTE DES DEMANDES :</h4>
          </div>
        </div>

        <table id="salesTable" class="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>CODE</th>
              <th>Magasin Demandeur</th>
              <th>Magasin de Traitement</th>
              <th>IPP</th>
              <th>NOM PATIENT</th>
              <th>TOTAL (MAD)</th>
              <th>URGENCE</th>
              <th>DATE </th>
              <th>POSITION</th>
              <th>ACT</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>



      {% include 'vente/GestionVente/inc/edit_demande_modal.html.twig' %}
      {% include 'vente/GestionVente/inc/detail_demande_modal.html.twig' %}

</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('gestion_vente') }}
  <script>
    window.PRODUITS = {{ produits|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
  </script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

{% endblock %}
