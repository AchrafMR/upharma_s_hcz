{% for demande in demandes %}
<div class="modal right fade" id="editDemande{{ demande.id }}" role="dialog" data-id="{{ demande.id }}" aria-hidden="true">
  <div class="modal-dialog" style="width: 50%" role="document">
    <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">MODIFIER LA DEMANDE</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span>&times;</span>
          </button>
        </div>

        <div class="modal-body">
        <!-- Infos générales -->
            <div class="form-row">
              <!-- Demandeur -->
              <div class="form-group col-md-6">
                <label for="demandeur_id">Demandeur</label>
                <select id="demandeur_id" name="demandeur_id" class="form-control">
                  {% for magasin in magasins %}
                    <option value="{{ magasin.id }}" {% if demande.demandeurId.id == magasin.id %}selected{% endif %}>
                      {{ magasin.designation }}
                    </option>
                  {% endfor %}
                </select>
              </div>

              <!-- Récepteur -->
              <div class="form-group col-md-6">
                <label for="recepteur_id">Récepteur</label>
                <select id="recepteur_id" name="recepteur_id" class="form-control">
                  {% for magasin in magasins %}
                    <option value="{{ magasin.id }}" {% if demande.recepteurId.id == magasin.id %}selected{% endif %}>
                      {{ magasin.designation }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            </div>

            <div class="form-row">
              <!-- IPP -->
              <div class="form-group col-md-6">
                <label for="ipp">IPP (ID Patient)</label>
                <input type="text" id="ipp" name="ipp" class="form-control" value="{{ demande.ipp }}" placeholder="Identifiant du patient" />
              </div>

              <!-- Nom du Patient -->
              <div class="form-group col-md-6">
                <label for="nom_patient">Nom du Patient</label>
                <input type="text" id="nom_patient" name="nom_patient" class="form-control" value="{{ demande.nomPatient }}" placeholder="Nom complet du patient" />
              </div>
            </div>

            <div class="form-row">
              <!-- Dossier Patient -->
              <div class="form-group col-md-6">
                <label for="dossier_patient">Dossier Patient</label>
                <input type="text" id="dossier_patient" name="dossier_patient" class="form-control" value="{{ demande.dossierPatient }}" placeholder="Code dossier patient" />
              </div>

              <!-- Description -->
              <div class="form-group col-md-6">
                <label for="description">Description</label>
                <input type="text" id="description" name="description" class="form-control" value="{{ demande.description }}" placeholder="Description..." />
              </div>
            </div>

            <!-- Urgent -->
            <div class="urgent-check-wrapper">
              <label class="form-check-label" for="urgent">URGENT</label>
              <input class="form-check-input" type="checkbox" id="urgent" name="urgent" {% if demande.urgent %}checked{% endif %} />    
            </div>



          <!-- Produits -->
          <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h5 class="mb-0">Produits</h5>
              <button type="button" class="btn btn-sm btn-primary"><i class="fa fa-plus"></i></button>
            </div>

            <table class="table table-bordered">
              <thead>
                <tr>
                  
                    <th style="width: max-content;">Produit</th>
                    <th style="width: 7%;">Quantité</th>
                    <th style="width: 10%;">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for ligne in demande.tMsDemandelgs %}
                  <tr data-id="{{ ligne.pProduit.id }}" data-demandelg-id="{{ ligne.id }}">
                    <td style="vertical-align: top !important; text-align: left !important;">
                      <select class="form-control form-control-sm product-select" disabled>
                        {% for produit in produits %}
                          <option value="{{ produit.id }}" data-prix="{{ produit.price }}"
                            {% if produit.id == ligne.pProduit.id %}selected{% endif %}>
                            {{ produit.name }}
                          </option>
                        {% endfor %}
                      </select>
                    </td>
                    <td>
                      <input type="number" class="form-control form-control-sm quantity-input" value="{{ ligne.quantite }}" min="1" disabled>
                    </td>
                    <td class="text-center">
                      <button type="button" class="btn btn-sm btn-edit-line" title="Modifier">
                        <i class="fa fa-edit text-primary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-delete-line" title="Supprimer">
                        <i class="fa fa-trash text-danger"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-save-line d-none" title="Enregistrer">
                        <i class="fa fa-save text-success"></i>
                      </button>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div class="modal-footer">
          <button type="submit" class="btn btn-primary btn-save-edit" data-id="{{ demande.id }}">
            <i class="fa fa-save"></i> Sauvegarder
          </button>
        </div>
    </div>
  </div>
</div>
{% endfor %}
