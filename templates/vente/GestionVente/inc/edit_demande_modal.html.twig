<!-- Modals loop -->
{% for demande in demandes %}
<div
  class="modal right fade"
  id="editCommande{{ demande.id }}"
  role="dialog"
  aria-labelledby="editCommande"
  aria-hidden="true"
>
  <div class="modal-dialog" style="width: 60%" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">MODIFIER LA DEMANDE</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <div class="row">
          <!-- Demandeur -->
          <div class="form-group col-md-6">
            <label>Demandeur</label>
            <select class="form-control">
              <option value="">-- Sélectionner un magasin Demandeur --</option>
              
              {% for magasin in magasins %}
               <option value="{{ magasin.id }}"
                  {% if demande.demandeurId.id == magasin.id %}selected{% endif %}>
                  {{ magasin.designation }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- Récepteur -->
          <div class="form-group col-md-6">
            <label>Récepteur</label>
            <select class="form-control">
              <option value="">-- Sélectionner un magasin Récepteur --</option>
              {% for magasin in magasins %}
                <option value="{{ magasin.id }}"
                  {% if demande.recepteurId.id == magasin.id %}selected{% endif %}>
                  {{ magasin.designation }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="row align-items-end">
          <!-- Description -->
          <div class="form-group col-md-6">
            <label>Description</label>
            <input type="text" class="form-control" value="{{ demande.description }}">
          </div>

          <!-- Urgent -->
          <div class="form-group col-md-6 d-flex align-items-end">
            <div class="form-check mb-2 ms-3">
              <input type="checkbox" class="form-check-input"
                {% if demande.urgent %}checked{% endif %}>
              <label class="form-check-label">Urgent</label>
            </div>
          </div>
        </div>

        <!-- Patient Info -->
        <div class="form-group">
          <label>IPP (ID Patient)</label>
          <input type="text" class="form-control" value="{{ demande.ipp }}">
        </div>

        <div class="form-row">
          <div class="form-group col-md-6">
            <label>Nom du Patient</label>
            <input type="text" class="form-control" value="{{ demande.nomPatient }}">
          </div>
          <div class="form-group col-md-6">
            <label>Dossier Patient</label>
            <input type="text" class="form-control" value="{{ demande.dossierPatient }}">
          </div>
        </div>

        <!-- Product Table -->
        <div class="mt-4">
          <h5>Produits dans la Demande</h5>
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Produit</th>
                <th>Prix</th>
                <th>Quantité</th>
                <th>Remise</th>
                <th>TVA</th>
                <th>Total TTC</th>
              </tr>
            </thead>
            <tbody>
              {# {% for ligne in demande.tMsDemandelgs %}
                <tr>
                  <td>{{ ligne.pProduit.nom }}</td>
                  <td><input type="number" class="form-control" value="{{ ligne.prixUnitaire }}"></td>
                  <td><input type="number" class="form-control" value="{{ ligne.quantite }}"></td>
                  <td><input type="number" class="form-control" value="{{ ligne.remise }}"></td>
                  <td><input type="number" class="form-control" value="{{ ligne.tva }}"></td>
                  <td>
                    {% set ht = ligne.prixUnitaire * ligne.quantite - ligne.remise %}
                    {{ (ht + (ht * ligne.tva / 100))|number_format(2, '.', ' ') }} DH
                  </td>
                </tr>
              {% endfor %} #}

            </tbody>
          </table>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-success">
          <i class="fa fa-save"></i> Sauvegarder
        </button>
      </div>
    </div>
  </div>
</div>
{% endfor %}
