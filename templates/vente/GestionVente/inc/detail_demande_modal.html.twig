<!-- Modals loop -->
{% for demande in demandes %}
<div
  class="modal right fade"
  id="detailsDemande{{ demande.id }}"
  role="dialog"
  aria-labelledby="detailsDemande"
  aria-hidden="true"
>
  <div class="modal-dialog" style="width: 55%" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Détails de la commande</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <div class="form-row">
          <div class="form-group col-md-6">
            <label>Magasin Demandeur</label>
            <select class="form-control" disabled>
              {# <option value="">-- Sélectionner un magasin Demandeur --</option> #}
              {% for magasin in magasins %}
                <option value="{{ magasin.id }}"
                  {% if demande.demandeurId.id == magasin.id %}selected{% endif %}>
                  {{ magasin.designation }}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="form-group col-md-6">
            <label>Magasin de Traitement</label>
            <select class="form-control" disabled>
              {# <option value="">-- Sélectionner un magasin Récepteur --</option> #}
              {% for magasin in magasins %}
                <option value="{{ magasin.id }}"
                  {% if demande.recepteurId.id == magasin.id %}selected{% endif %}>
                  {{ magasin.designation }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
  
        <div class="form-row">
          <div class="form-group col-md-6">
            <label>IPP (ID Patient)</label>
            <input type="text" class="form-control" value="{{ demande.ipp }}" disabled>
          </div>

          <div class="form-group col-md-6">
              <label>Date demande</label>
              <input type="text" class="form-control" value="{{ demande.created|date('d/m/Y') }}" disabled>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group col-md-6">
            <label>Nom du Patient</label>
            <input type="text" class="form-control" value="{{ demande.nomPatient }}" disabled>
          </div>
          <div class="form-group col-md-6">
            <label>Dossier Patient</label>
            <input type="text" class="form-control" value="{{ demande.dossierPatient }}" disabled>
          </div>
        </div>

        <div class="form-row ">
          <div class="form-group col-md-6">
            <label>Description</label>
            <input type="text" class="form-control" value="{{ demande.description }}" disabled>
          </div>

          <div class=" urgent-check-wrapper ">
              <input type="checkbox" class="form-check-input" {% if demande.urgent %}checked{% endif %} disabled>
              <label class="form-check-label">Urgent</label>           
          </div>
        </div>

        <div class="mt-3">
          <h5>Produits dans la Demande</h5>

          <div style="max-height: 319px; overflow-y: auto;">
            <table class="table table-bordered mb-0">
              <thead class="table-light" style="position: sticky; top: 0; background: white; z-index: 1;">
                <tr>
                  <th>#</th>
                  <th style="width: max-content;">Produit</th>
                  <th style="width: 10%;">Quantité</th>
                  <th style="width: 10%;">Prix</th>
                  <th style="width: 10%;">TOTAL</th>
                </tr>
              </thead>
              <tbody>
                {% set grand_total = 0 %}
                {% for ligne in demande.tMsDemandelgs %}
                  {% set ligne_total = ligne.montantTtc %}
                  {% set grand_total = grand_total + ligne_total %}
                  <tr>
                    <td style="vertical-align: top !important;">{{ loop.index }}</td>
                    <td style="vertical-align: top !important; text-align: left !important;">{{ ligne.pProduit.titre ?? '—' }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.quantite }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne_total|number_format(2, ',', ' ') }}</td>
                  </tr>
                {% else %}
                  <tr><td colspan="5">Aucune ligne de demande trouvée</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <div style="text-align: right !important;" class="mt-2">
            <h5><strong>Total général: {{ grand_total|number_format(2, ',', ' ') }} DH</strong></h5>
          </div>
        </div>

      </div>

      <div class="modal-footer">
          {% if demande.positionActuel == 'Créer' %}
            <button type="button" class="btn btn-primary btn-valider" data-id="{{ demande.id }}">
              Valider
            </button>
          {% elseif demande.positionActuel == 'valider' %}
            <button type="button" class="btn btn-danger btn-devalider" data-id="{{ demande.id }}">
              Dévalider
            </button>
            <button type="button" class="btn btn-primary btn-generer" data-id="{{ demande.id }}">
              Générer
            </button>
          {% else %}
            <button type="button" class="btn btn-secondary" data-dismiss="modal">
              Fermer
            </button>
          {% endif %}
      </div>

    </div>
  </div>
</div>
{% endfor %}
