
{% for commande in commandes %}
<div
  class="modal right fade"
  id="detailsCommande{{ commande.id }}"
  role="dialog"
  aria-labelledby="detailsCommande"
  aria-hidden="true"
>
  <div class="modal-dialog" style="width: 65%" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Détails de la commande</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <div class="row">
          <div class="col-md-9" style="border-right: solid 1px #80808052;">
            <div class="row">
              <div class="col-md-4">
                <label>Magasin Demandeur</label>
                <select class="form-control" name="demandeur_id" disabled>
                  {% for magasin in magasinsDemandeur %}
                    <option value="{{ magasin.id }}"
                      {% if commande.demandeurId and commande.demandeurId.id == magasin.id %}selected{% endif %}>
                      {{ magasin.designationAccess }}
                    </option>
                  {% endfor %}
                </select>
              </div>

              <div class="col-md-4">
                <label>Magasin de Traitement</label>
                <select class="form-control" name="recepteur_id" disabled>
                  {% for magasin in magasinsTraitement %}
                    <option value="{{ magasin.id }}"
                      {% if commande.recepteurId and commande.recepteurId.id == magasin.id %}selected{% endif %}>
                      {{ magasin.designationAccess }}
                    </option>
                  {% endfor %}
                </select>
              </div>
          
              <div class="col-md-4">             
                  <label>IPP (ID Patient)</label>
                  <input type="text" class="form-control" value="{{ commande.ipp }}" disabled>
              </div>

              <div class="col-md-4">
                  <label>Date commande</label>
                  <input type="text" class="form-control" value="{{ commande.created|date('d/m/Y') }}" disabled>
              </div>
            

              <div class="col-md-4">      
                <label>Nom du Patient</label>
                <input type="text" class="form-control" value="{{ commande.nomPatient }}" disabled>
              </div>

              <div class="col-md-4">
                <label>Dossier Patient</label>
                <input type="text" class="form-control" value="{{ commande.dossierPatient }}" disabled>
              </div>
              

              <div class="col-md-4 ">
                <label>Type d’opération</label>
                <input type="text" class="form-control"
                  value="{{ commande.typeCommande.id == 2 ? 'Consommation' : (commande.typeCommande.id == 3 ? 'Retour Patient' : commande.typeCommande.id) }}" 
                  disabled
                >
                <input type="hidden" name="type_commande_id_hidden" value="{{ commande.typeCommande.id }}">
              </div>

              <div class="col-md-4 ">
                  <label>Description</label>
                  <input type="text" class="form-control" value="{{ commande.description }}" disabled>
              </div>

              <div class="col-md-1">
                  <label class="form-label">urgent </label>
                  <input disabled required name="urgent" id="urgent" type="checkbox" class="form-control urgent" {% if commande.urgent == 1 %}
                      checked
                  {% endif %} style="width: fit-content;">
              </div> 
            </div>
          </div>
          <div class="col-md-3 p-0">
              <!-- impressions associées -->
              <div class="panel-group p-2" id="accordion" role="tablist" aria-multiselectable="true">
                  <div class="panel panel-default">
                      <div class="panel-heading" role="tab" id="headingOne">
                          <h5 class="panel-title"> <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="true" aria-controls="collapseOne"> impressions associées</a> </h5>
                      </div>
                      <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne">
                          <div class="panel-body" style="padding: 0 15px;">
                              <table style="font-size: 13px; border-collapse: collapse; border: none !important;">
                                  <tr style="border: none !important;">
                                      <td style="font-weight: 600; padding-right: 5px; text-align: start !important; border: none !important;">Demande</td>
                                      <td style="padding-right: 5px; border: none !important;">:</td>
                                      <td style="text-align: start !important; border: none !important;">
                                          <a href="#"
                                          class="genererPdfDemandeSortieStock"
                                          data-id="{{ commande.tMsDemande.id }}"
                                          target="_blank">
                                              {{ commande.tMsDemande.code }}
                                              <i class="fa-solid fa-file-pdf" style="margin-left: 5px;"></i>
                                          </a>
                                      </td>
                                  </tr>
                                  <tr style="border: none !important;">
                                      <td style="font-weight: 600; padding-right: 5px; text-align: start !important; border: none !important;">Commande</td>
                                      <td style="padding-right: 5px; border: none !important;">:</td>
                                      <td style="text-align: start !important; border: none !important;">
                                          <a href="#"
                                          class="genererPdfCommandeSortieStock"
                                          data-id="{{ commande.id }}"
                                          target="_blank">
                                              {{ commande.code }}
                                              <i class="fa-solid fa-file-pdf" style="margin-left: 5px;"></i>
                                          </a>
                                      </td>
                                  </tr>
                              </table>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
        </div>

        <div class="mt-2">
                <h5>Produits dans la Commande</h5>

                <div style="max-height: 319px; overflow-y: auto;">
                  <table class="table table-bordered mb-0">
                    <thead class="table-light" style="position: sticky; top: 0; background: white; z-index: 1;">
                      <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: max-content;">Produit</th>
                        <th style="width: 10%;">Quantité</th>
                        <th style="width: 10%;">Prix</th>
                        <th style="width: 10%;">TOTAL</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% set grand_total = 0 %}
                      {% for ligne in commande.tMsCommandelgs %}
                        {% set ligne_total = ligne.montantTtc %}
                        {% set grand_total = grand_total + ligne_total %}
                        <tr>
                          <td style="vertical-align: top !important;">{{ ligne.pProduit.id }}</td>
                          <td style="vertical-align: top !important; text-align: left !important;">{{ ligne.pProduit.titre ?? '—' }}</td>
                          <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.quantitecommandee }}</td>
                          <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }}</td>
                          <td style="vertical-align: top !important; text-align: right !important;">{{ ligne_total|number_format(2, ',', ' ') }}</td>
                        </tr>
                      {% else %}
                        <tr><td colspan="5">Aucune ligne de commande trouvée</td></tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>

                <div style="text-align: right !important;" class="mt-2">
                  <h5><strong>Total général: {{ grand_total|number_format(2, ',', ' ') }} DH</strong></h5>
                </div>
        </div>
      </div>

      <div class="modal-footer">
        
          {% if commande.status.id == 9 %}
            <button type="button" class="btn btn-primary btn-valider" data-id="{{ commande.id }}">
              Valider
            </button>
          {% elseif commande.status.id == 12 and commande.recepteurId.id == commande.demandeurId.id %}
            <button type="button" class="btn btn-primary btn-generer"
              data-id="{{ commande.id }}"
              data-type="{{ commande.typeCommande.id }}">
              Générer
            </button>
          {% endif %}
      </div>

    </div>
  </div>
</div>
{% endfor %}
