{% for commande in commandes %}
<div
  class="modal right fade"
  id="preparerLivraison{{ commande.id }}"
  role="dialog"
  aria-labelledby="preparerLivraison"
  aria-hidden="true"
>
  <div class="modal-dialog" style="width: 55%" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Préparer la Livraison</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <form class="livraison-form" data-id="{{ commande.id }}">
          <input type="hidden" name="commande_id" value="{{ commande.id }}"/>

          <div style="max-height: 319px; overflow-y: auto;">
            <table class="table table-bordered mb-0">
              <thead class="table-light" style="position: sticky; top: 0; background: white; z-index: 1;">
                <tr>
                  <th>#</th>
                  <th style="width: max-content;">Produit</th>
                  <th style="width: 7%;">Commandée</th>
                  <th style="width: 7%;">Déjà Livrée</th>
                  <th style="width: 7%;">Reste</th>
                  <th style="width: 7%;">À Livrer</th>
                </tr>
              </thead>
              <tbody>
                {% for ligne in commande.tMsCommandelgs %}
                  <tr>
                    <td style="vertical-align: top !important; text-align: center !important;">
                       {{ loop.index }}
                    <td style="vertical-align: top !important; text-align: left !important;">{{ ligne.pProduit.titre }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.quantiteCommandee }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.quantiteServie }}</td>
                    <td style="vertical-align: top !important; text-align: right !important;">{{ ligne.quantiteReste }}</td>
                    <td>
                      <input type="number"
                             step="1"
                             min="0"
                             max="{{ ligne.quantiteReste }}"
                             name="quantites[{{ ligne.id }}]"
                             class="form-control form-control-sm"
                             placeholder="0"
                             value="{{ ligne.quantiteReste }}" />
                    </td>
                  </tr>
                {% else %}
                  <tr><td colspan="5">Aucune ligne de commande trouvée</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <button type="button"
                class="btn btn-primary btn-confirmer-livraison"
                data-id="{{ commande.id }}">
          Confirmer la Livraison
        </button>
      </div>
    </div>
  </div>
</div>
{% endfor %}
