{% extends 'base.html.twig' %} {% block title %}Gestion des commandes{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link
  rel="stylesheet"
  href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css"
/>
{% endblock %} {% block body %}
<div class="main">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mt-4">
        <table id="commandeTable" class="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>CODE</th>
              <th>DATE</th>
              <th>DESCRIPTION</th>
              <th>MAGASIN DEMANDEUR</th>
              <th style="width: 15%;">MAGASIN DE TRAITEMENT</th>
              <th>IPP</th>
              <th>NOM PATIENT</th>
              <th>TOTAL (MAD)</th>
              <th>URGENCE</th>   
              <th>POSITION</th>
              <th>ACT</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  {% include 'vente/GestionCommande/inc/edit_commande_modal.html.twig' %}
  {% include 'vente/GestionCommande/inc/detail_commande_modal.html.twig' %}
  {% include 'vente/GestionCommande/inc/preparer_livraison_commande_modal.html.twig' %}
</div>
{% endblock %} {% block javascripts %}

<script>
  window.infos_patient = {{ infosPatient|json_encode|raw }};
  window.PRODUITS = {{ produits|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};  
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{{ parent() }}
{{ encore_entry_script_tags("gestion_commandes") }}

{% endblock %}
