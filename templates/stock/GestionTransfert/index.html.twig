{% extends 'base.html.twig' %} {% block title %}Gestion des Ventes{% endblock %}
{% block stylesheets %}

{{ parent() }}
<link
  rel="stylesheet"
  href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css"
/>
{% endblock %} {% block body %}
<div class="main">
  <div class="container">
    <div
      class="col-md-6 mt-2 d-flex justify-content-end align-items-center ml-auto"
    >
      {% for action in actions %} {% if action.horizontal and action.principal %}
          <button
            class=" {{ action.className }}"
            data-target="#{{ action.idName }}"
          >
            <i class="{{ action.icon }}"></i>
          </button>
          {% endif %} {% endfor %}
    </div>
    <div class="row">
      <div class="col-md-12 mt-2">
        <table id="salesTable" class="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>CODE</th>
              <th>DATE</th>
              <th>DESCRIPTION</th>
              <th>MAGASIN DEMANDEUR</th>
              <th style="width: 15%">MAGASIN DE TRAITEMENT</th>
              <th>TOTAL (MAD)</th>
              <th>URGENCE</th>
              <th>POSITION</th>
              <th>ACT</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  {% include 'stock/GestionTransfert/inc/edit_demande_modal.html.twig' %} 
  {% include 'stock/GestionTransfert/inc/ajouter_transfert_modal.html.twig' %} 
  {% include 'stock/GestionTransfert/inc/detail_demande_modal.html.twig' %}
</div>
{% endblock %} {% block javascripts %}
<script>
  window.PRODUITS = {{ produits|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

{{ parent() }}
{{ encore_entry_script_tags("gestion_transfert") }}
{% endblock %}
