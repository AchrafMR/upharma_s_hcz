{% extends 'base.html.twig' %} {% block title %}OPÉRATION PATIENT{% endblock %}
{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags("operation_patient") }}
{% endblock %} {% block body %}
<div class="d-flex align-items-center justify-content-between px-2 pt-2">
  <h2 class="h6 mb-0"></h2>

  {% for action in actions %} {% if action.horizontal and action.principal and action.ord == 1 %}
  <button
    type="button"
    class="{{ action.className }}"
    data-toggle="modal"
    data-target="#{{ action.idName }}"
  >
    <i class="{{ action.icon }}"></i>
  </button>
  {% endif %} {% endfor %}
</div>
{# <hr class="mt-2" /> #}

<div id="patientInfoContainer" class="px-2"></div>

{# <br/> #}

<div class="container-fluid px-2">
  <div class="row g-3 align-items-stretch">
    <!-- LEFT: Sortie Patient -->
    <div class="col-12 col-md-6 h-100">
      <fieldset class="fieldset-card h-100">
        <legend class="fieldset-legend">SORTIE PATIENT</legend>
        <div id="sortiePatientBlock">

        </div>
      </fieldset>
    </div>

    <!-- RIGHT: Commande Patient -->
    <div class="col-12 col-md-6 h-100">
      <fieldset class="fieldset-card h-100">
        <legend class="fieldset-legend">COMMANDE PATIENT</legend>
        <div id="commandePatientBlock">
            
        </div>
      </fieldset>
    </div>
  </div>

   <div class="d-flex align-items-center justify-content-between px-2 pt-1">
  <h2 class="h6 mb-0"></h2>

  {% for action in actions %} {% if action.horizontal and action.principal and action.ord == 2 %}
  <button
    type="button"
    class="{{ action.className }}"
  >
  {{action.nom}}
    <i class="{{ action.icon }}"></i>
  </button>
  {% endif %} {% endfor %}
</div>
</div>


{# Include the popup #} 
{% include 'mouvement/OperationPatient/popup/infoPatient_popup.html.twig' with { id:'opPatientPopup', title: 'Information Patient', auto_open: true } %} 
{% include 'mouvement/OperationPatient/modals/ajouter.html.twig' %} {% endblock %} 

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags("operation_patient") }}
{% endblock %}